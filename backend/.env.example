# LLM provider — "groq" is recommended for the <10s response target (PDF §6.1).
# Switch to "ollama" if running fully local without external API calls.
LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-70b-versatile

# Groq — free tier, no credit card. Get a key at https://console.groq.com
GROQ_API_KEY=

# Ollama — only used when LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434

# Voice input — remote Whisper server reachable from this backend.
# Example over Tailscale: http://100.x.y.z:9001/transcribe
WHISPER_REMOTE_URL=
WHISPER_REMOTE_TIMEOUT_SECONDS=120

# Caching + ops
CACHE_TTL_SECONDS=3600
CACHE_DIR=.cache
LOG_LEVEL=INFO
API_PORT=8000

# Default search center used when location can't be resolved
DEFAULT_LOCATION_LAT=40.7128
DEFAULT_LOCATION_LNG=-74.0060
DEFAULT_LOCATION_NAME=New York, NY
